{
	"name": "@jujanree/one",
	"version": "0.5.0",
	"description": "A modern utility library providing one-function solutions to routine JavaScript/TypeScript tasks",
	"keywords": [
		"utils"
	],
	"homepage": "https://github.com/jujanree/one#readme",
	"bugs": {
		"url": "https://github.com/jujanree/one/issues"
	},
	"license": "MIT",
	"author": "jujanree",
	"type": "module",
	"main": "./dist/main.js",
	"types": "./dist/main.d.ts",
	"scripts": {
		"build": "npx tsc --project .",
		"build-tests": "cd tests && npx tsc --project . && cd ..",
		"debug-build": "npx tsc --project ./ts/debug.json",
		"debug-tests": "cd tests && npx tsc --project ../ts/test-debug.json && cd ..",
		"build-all": "npm run build && npm run build-tests",
		"debug-all": "npm run debug-build && npm run debug-tests",
		"tests": "cd tests/out/ && node all.js"
	},
	"devDependencies": {
		"@types/node": "^26.3.0",
		"oxfmt": "^0.65.0",
		"typescript": "^6.0.3"
	}
}
